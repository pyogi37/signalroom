# Model provider. Any OpenAI-compatible chat endpoint works; Groq is the default.
# Put the real key in apps/api/.env (gitignored). Never commit it.
GROQ_API_KEY=
SIGNALROOM_MODEL_BASE_URL=https://api.groq.com/openai/v1
SIGNALROOM_MODEL=openai/gpt-oss-120b

# auto   = replay a recording when one exists, otherwise call live if a key is set
# live   = always call the provider
# replay = never call the provider; only recorded runs work
# record = call the provider and save the response for replay
SIGNALROOM_MODEL_MODE=auto

# Optional. USD per million tokens, used only for the per-run cost estimate.
# SIGNALROOM_PRICE_INPUT_PER_M=
# SIGNALROOM_PRICE_OUTPUT_PER_M=
